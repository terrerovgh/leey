{
  "name": "leey",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sitio web de Leyanis \u201cLeey\u201d Hernandez \u2014 Lock & Key Realty",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "sync:zillow": "node scripts/sync-zillow.mjs",
    "sync:zillow:demo": "node scripts/sync-zillow.mjs --force-demo",
    "sync:manual": "node scripts/sync-zillow.mjs --manual-only",
    "deploy": "npm run build && npx wrangler deploy",
    "ship": "npm run check && npm run build && npx wrangler deploy",
    "sync:daily": "bash scripts/daily-listings-update.sh",
    "blog:daily": "bash scripts/blog-publish-morning.sh",
    "blog:build-check": "npm run check",
    "blog:prep": "bash scripts/blog-prep.sh",
    "blog:publish": "bash scripts/blog-publish-morning.sh",
    "blog:pipeline": "python3 scripts/blog_pipeline/run.py"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.518.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
