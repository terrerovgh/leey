# Copy to .env — never commit secrets

ZILLOW_AGENT_NAME="Leyanis Hernandez"
ZILLOW_AGENT_LOCATION="Valdosta, GA"
ZILLOW_PROFILE_URL="https://www.zillow.com/profile/leey63/"

# market | brokerage | mls | hybrid | manual
# brokerage = Lock & Key only (recommended for leeyrealty.com)
SYNC_MODE=brokerage
ZILLOW_SYNC_MODE=brokerage

ZILLOW_MLS_FILE=data/mls-ids.txt
# ZILLOW_MLS_IDS=147230,10312024
MANUAL_LISTINGS_PATH=data/manual-listings.json

# Georgia MLS public resolver (no RapidAPI) — uses ids from mls-ids.txt
GAMLS_ENABLED=1
# GAMLS_INCLUDE_SOLD=1   # only for debugging; site hides sold by default

ZILLOW_LOCATIONS="Valdosta, GA;Hahira, GA;Adel, GA;Moultrie, GA;Thomasville, GA;Tifton, GA;Nashville, GA;Ray City, GA;Lake Park, GA;Sparks, GA;Lenox, GA"
ZILLOW_MAX_PAGES=1
ZILLOW_MAX_LISTINGS=80
# real-estate-zillow-com: page>1 is flaky; keep 1 unless you verify pagination
ZILLOW_REZ_MAX_PAGES=1
ZILLOW_PROPERTY_TYPES=house
ZILLOW_SORT=relevant
# Extra /byurl detail pulls (legacy scraper host only)
ZILLOW_ENRICH_LIMIT=0
ZILLOW_BROKERAGE_FILTER="lock and key,lock & key,lockandkey"

# Shared RapidAPI key
RAPIDAPI_KEY=
# Preferred (working 2026-08): real-estate-zillow-com.p.rapidapi.com
#   GET /v1/search/sale?location_or_rid=Valdosta%2C%20GA&property_types=house&sort=relevant&page=1
#   GET /v1/search/sold?...&doz=7
# Legacy (quota-limited): zillow-com-live-data-scraper-api.p.rapidapi.com
RAPIDAPI_HOST=real-estate-zillow-com.p.rapidapi.com
RAPIDAPI_GAP_MS=1300

# Realtor.com via RapidAPI — subscribe ONE product, then set host:
#   realty-in-us.p.rapidapi.com     (classic)
#   realtor16.p.rapidapi.com
#   us-real-estate.p.rapidapi.com
REALTOR_ENABLED=1
REALTOR_RAPIDAPI_HOST=realty-in-us.p.rapidapi.com

# If all API sources fail, keep previous public/data/listings.json (1=yes)
KEEP_LAST_GOOD=1

# Optional commercial
LOOPNET_RAPIDAPI_HOST=loopnet-api.p.rapidapi.com

# Optional Apify agent-profile scraper
# APIFY_TOKEN=
# APIFY_ACTOR_ID=maxcopell/zillow-agent-scraper

# ── Blog Studio CMS (Cloudflare Worker) ────────────────────────────────────
# After `wrangler secret put AGENT_TOKEN`, put the same value here so the
# multi-agent publish stage can upsert into live KV (/data/blog/posts.json).
# LEEY_BLOG_AGENT_TOKEN=
# LEEY_BLOG_CMS_URL=https://leeyrealty.com
# Magic-link email (also: wrangler secret put RESEND_API_KEY)
# RESEND_API_KEY=
