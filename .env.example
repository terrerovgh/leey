# Copy to .env (never commit .env)

ZILLOW_AGENT_NAME=Leyanis Hernandez
ZILLOW_AGENT_LOCATION=Valdosta, GA
ZILLOW_PROFILE_URL=

# RapidAPI product: Zillow Com Live Data Scraper API
# Host: zillow-com-live-data-scraper-api.p.rapidapi.com
# Endpoint (known): GET /bymlsid?mlsid={id}&page=1
RAPIDAPI_KEY=
RAPIDAPI_HOST=zillow-com-live-data-scraper-api.p.rapidapi.com

# Optional MLS list for /bymlsid
# ZILLOW_MLS_IDS=123456,789012

# Optional alternatives
# APIFY_TOKEN=
# MANUAL_LISTINGS_PATH=./data/manual-listings.json
