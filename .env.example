# Zillow / listings sync — copy to .env and fill in
# Zillow has NO public bulk API. Use one of these providers:

# Required for targeting the right agent
ZILLOW_AGENT_NAME=Leyanis Hernandez
ZILLOW_AGENT_LOCATION=Valdosta, GA
# Public Zillow agent profile URL (find via zillow.com → Find an Agent)
ZILLOW_PROFILE_URL=

# Option A (recommended): Apify actor
APIFY_TOKEN=
# APIFY_ACTOR_ID=maxcopell/zillow-agent-scraper

# Option B: RapidAPI Zillow product
RAPIDAPI_KEY=
# RAPIDAPI_HOST=zillow-com1.p.rapidapi.com

# Option C: hand-exported JSON array of listings
# MANUAL_LISTINGS_PATH=./data/manual-listings.json
